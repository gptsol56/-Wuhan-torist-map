# ====== 后端代理配置 ======
# 复制为 .env 后填入真实值：cp .env.example .env

# 及客智能 API Key（必填）
# ⚠️ 永不要把真实 key 提交到 git；只能放在 .env 或部署平台的环境变量里
JIKE_API_KEY=

# 及客智能 API Base URL（真实：data-api.isjike.com）
JIKE_API_BASE=https://data-api.isjike.com

# 及客智能 API 路径（人流量热力图，固定 POST）
JIKE_API_PATH=/api/v1/heat_map

# 请求方式（固定 POST）
JIKE_HTTP_METHOD=POST

# S2 Cell 等级（10~18，越高栅格越细、数据量越大）。武汉主城区景点半径 500m 建议 14
CELL_LEVEL=14

# 圆形围栏半径（米），覆盖景点主要区域
HEAT_RADIUS_METERS=500

# 景点原始坐标系统：gcj02（腾讯地图, 默认）| bd09（百度）| wgs84（GPS）
SPOT_COORD_SYS=gcj02

# 缓存时间（秒）。及客智能热力数据为历史 10 天，5 分钟足够。
CACHE_TTL_SECONDS=300

# 服务监听端口
PORT=3000

# 允许跨域来源（前端 HTML 所在域，多个用逗号分隔；本地开发用 *）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500,*

# 是否返回 mock 数据（key 未配置或 value 为 false 时）
ENABLE_MOCK=true

# 即使配了 key 也强制走 mock：预览/联调时完全不耗额度。排查「本地一直显示估算」时先查这个。
# CROWD_FORCE_MOCK=true

# 上游返回 QUOTA_EXHAUSTED 后的熔断冷却窗口（秒）。窗口内不再打上游，
# 直接用快照/mock；到点自动放一个探针请求试探配额是否恢复。默认 300s。
QUOTA_COOLDOWN_SECONDS=300
